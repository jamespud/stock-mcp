# MySQL（外部数据库，通过连接串配置；不随 MCP server 内置）
# 优先使用 DATABASE_URL，未设置时回退到下面的 DB_* 离散变量
DATABASE_URL=mysql://stock:stock123@127.0.0.1:3306/stock_mcp
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stock
DB_PASSWORD=stock123
DB_NAME=stock_mcp

# Providers
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36
REQUEST_DELAY_MS=300
# 可选：所有 Node fetch 请求走 HTTP(S) 代理（Yahoo 在大陆需代理）
PROXY_URL=http://127.0.0.1:17890

# Sync defaults
BARS_START_DATE=2000-01-01
BARS_PROVIDER=yahoo
NEWS_COUNT=20
